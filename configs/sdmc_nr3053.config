# SDMC NR3053 (MT7981 + SPI-NAND); target profile supplies the rest.
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_sdmc_nr3053=y

CONFIG_PACKAGE_luci=y

# DEVEL makes CCACHE selectable; the workflow caches .ccache between runs.
CONFIG_DEVEL=y
CONFIG_CCACHE=y
